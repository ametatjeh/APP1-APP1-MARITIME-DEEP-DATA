# ==============================================================================
# Maritime Deep Data (App 1 Only) - Production Environment Template
# INSTRUCTIONS: Copy to .env in production and populate all secret placeholders.
# NEVER commit production credentials to Git or public repositories.
# ==============================================================================

APP_NAME="Maritime Deep Data"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mdd-investigations.ngo.internal

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration (Daily rotated logs, Info level for production)
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_MAX_FILES=30

# Database Configuration (PostgreSQL 18 + PostGIS 3.6.2)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maritime_deep_data
DB_USERNAME=mdd_db_user
DB_PASSWORD=REPLACE_WITH_SECURE_GENERATED_PASSWORD
DB_SSLMODE=prefer

# Session Configuration (Encrypted, Redis-backed, Strict Cookie Isolation)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Cache & Queue (Redis clustered/standalone on loopback)
CACHE_STORE=redis
CACHE_PREFIX=mdd_cache_
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database_uuids

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_AUTH
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Filesystem & Evidence Storage (Strictly Private Object Storage / Disk)
# Evidence is stored OUTSIDE public web root in storage/app/private_evidence
FILESYSTEM_DISK=private

# Internal AI Microservice Configuration (Python FastAPI Multi-Agent Engine)
# Bound to localhost loopback only, guarded by shared internal HMAC token
AI_SERVICE_URL=http://127.0.0.1:8100
AI_SERVICE_TOKEN=REPLACE_WITH_STRONG_SHARED_SECRET_KEY
AI_SERVICE_TIMEOUT_CONNECT=0.5
AI_SERVICE_TIMEOUT_REQUEST=2.0

# Sanctum & API Authentication
SANCTUM_STATEFUL_DOMAINS=mdd-investigations.ngo.internal

# Operational Mailer (Internal SMTP / Alert notifications)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@maritimedeepdata.ngo.internal"
MAIL_FROM_NAME="${APP_NAME} Investigations"

# Maintenance Driver
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
